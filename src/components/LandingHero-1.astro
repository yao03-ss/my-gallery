---
import siteConfig from '../../site.config.mjs';

const owner = siteConfig.owner;
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
---

<div class="absolute left-0 right-0 z-0">
	<div class="text-center mb-12 relative z-10">
		<h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6 leading-tight">
			Yao Art Gallery
		</h1>
		<p class="mt-4 text-base md:text-lg text-gray-700">A place to showcase my illustrations</p>
		<a
			href={`${base}/collections`}
			class="inline-block border border-black rounded-md py-2 px-6 text-lg font-medium transition-colors hover:bg-black hover:text-white"
			>
			View Gallery
		</a>
	</div>
</div>
